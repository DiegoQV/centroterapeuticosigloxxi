# ==============================================================================
# VARIABLES DE ENTORNO — CENTRO TERAPÉUTICO SIGLO XXI
# ==============================================================================
# Copia este archivo a .env.local y completa los valores correspondientes.
# NUNCA agregues valores de producción reales a este archivo.

# Variables Públicas (Cliente / Navegador)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Variables de Servidor (Privadas — NUNCA exponer al cliente)
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-privada-aqui
JWT_SECRET_PATIENT_ACCESS=tu-secreto-jwt-para-pacientes-min-32-caracteres
CLINICA_ID_DEFAULT=00000000-0000-0000-0000-000000000001
